# 复制为 .env 后按本机修改；.env 不提交。

# 服务
NODE_ENV=development          # development / test / production
PORT=3000
LOG_LEVEL=info               # fatal / error / warn / info / debug / trace / silent
# 接口文档页面 /docs；不写时开发和测试环境开启、生产环境关闭
# SWAGGER_ENABLED=true

# MySQL（本地开发用 deploy/docker-compose.yml 启动；后端和 compose 共用这几项）
# 端到端测试连同一个 MySQL 的 ${DB_NAME}_test 库（compose 首次启动时自动建好），测试会清空它
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=jim_admin
DB_USER=jim_admin
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
# 启动时按实体自动建表，只允许 NODE_ENV=test；开发和生产用迁移
# DB_SYNCHRONIZE=false
# 只读查询超时（毫秒），超过由 MySQL 中止；0 表示不限
# DB_QUERY_TIMEOUT_MS=30000

# Redis（后端和 compose 共用这几项）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-me
# REDIS_DB=0
# 所有键的前缀；端到端测试固定用 jna-test:，只清理自己的键
# REDIS_KEY_PREFIX=jna:

# 登录认证（T05）。密钥至少 32 个字符，用随机串，例如：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
# 后台前端地址（刷新、退出、切换组织时核对 Origin），多个用逗号分隔；生产环境必填
AUTH_ADMIN_ORIGINS=http://localhost:8848
# 仅 bootstrap:local 使用；只允许本机开发库 jim_admin_local，初始化一次后不会覆盖账号。
# 不填时默认 admin / 123456（只限本机开发，登录后请修改）
# BOOTSTRAP_USERNAME=admin
# BOOTSTRAP_PASSWORD=123456
# AUTH_ACCESS_TTL_MINUTES=30       # 访问令牌有效期
# AUTH_REFRESH_TTL_DAYS=7          # 刷新令牌（会话）有效期
# AUTH_IDLE_MINUTES=0              # 多久不操作自动退出，0 不启用
# AUTH_SINGLE_SESSION=false        # 同一账号只允许一处登录
# AUTH_LOCK_MAX_FAILS=5            # 同一账号连续输错几次锁定
# AUTH_LOCK_IP_MAX_FAILS=20        # 同一 IP 连续输错几次锁定
# AUTH_LOCK_MINUTES=15             # 锁定时长
# AUTH_CAPTCHA_MODE=always         # always 每次都要验证码；after-failure 输错过才要

# 安全基线（T25）
# TRUST_PROXY=0                    # 前面有几层受控的反向代理；0 表示直连，不信 X-Forwarded-For
# RATE_LIMIT_IP_PER_MINUTE=600     # 每个来源 IP 每分钟最多请求次数
# 跨域白名单按端配置：后台端用上面的 AUTH_ADMIN_ORIGINS；/open 不开跨域
# CORS_WEB_ORIGINS=https://www.example.com
# CORS_APP_ORIGINS=https://h5.example.com
# SECURITY_HSTS=true               # 不填时生产环境开、其他环境关

# 代码生成器（T21，只在开发环境生效）
# CODEGEN_ENABLED=true
# CODEGEN_SERVER_ROOT=D:/code/jim-nestjs-admin/server
# CODEGEN_ADMIN_ROOT=D:/code/jim-nestjs-admin/admin
