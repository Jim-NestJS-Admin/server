# 复制为 .env 后按本机修改；.env 不提交。

# 服务
NODE_ENV=development          # development / test / production
PORT=3000
LOG_LEVEL=info               # fatal / error / warn / info / debug / trace / silent
# 接口文档页面 /docs；不写时开发和测试环境开启、生产环境关闭
# SWAGGER_ENABLED=true

# 以下数据库和 Redis 配置供 deploy/docker-compose.yml 使用；后端在 T03、T04 接入后才读取
# MySQL（本地开发用 deploy/docker-compose.yml 启动）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=jim_admin
DB_USER=jim_admin
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-me
