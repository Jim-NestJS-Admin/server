# 复制为 .env 后按本机修改；.env 不提交。

# 服务
NODE_ENV=development          # development / test / production
PORT=3000
LOG_LEVEL=info               # fatal / error / warn / info / debug / trace / silent
# 接口文档页面 /docs；不写时开发和测试环境开启、生产环境关闭
# SWAGGER_ENABLED=true

# MySQL（本地开发用 deploy/docker-compose.yml 启动；后端和 compose 共用这几项）
# 端到端测试连同一个 MySQL 的 ${DB_NAME}_test 库（compose 首次启动时自动建好），测试会清空它
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=jim_admin
DB_USER=jim_admin
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
# 启动时按实体自动建表，只允许 NODE_ENV=test；开发和生产用迁移
# DB_SYNCHRONIZE=false

# Redis（后端在 T04 接入后读取）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-me
